{
  "expo": {
    "name": "Zendo",
    "slug": "ZENDO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo-sm.png",
    "scheme": "Zendo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Icon.png",
        "backgroundColor": "#1E1B4B"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.alifahmipro.Zendo"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1B4B",
          "image": "./assets/images/Icon.png",
          "dark": {
            "image": "./assets/images/Icon.png",
            "backgroundColor": "#1E1B4B"
          },
          "imageWidth": 200
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "androidNavigationBar": {
      "visible": "visible",
      "barStyle": "dark-content",
      "backgroundColor": "#111827"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "964e08fd-28a8-46e4-876c-e5ac9441bd3e"
      }
    }
  }
}
